{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "riscv: build hello_qemu",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/riscv-hello.mjs",
        "build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "riscv: run hello_qemu",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/riscv-hello.mjs",
        "run"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    },
    {
      "label": "riscv: debug hello_qemu",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/riscv-hello.mjs",
        "debug"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": {
        "base": "$msCompile",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^QEMU waiting for GDB on tcp::3333$",
          "endsPattern": "^QEMU waiting for GDB on tcp::3333$"
        }
      },
      "isBackground": true
    },
    {
      "label": "riscv: clean hello_qemu",
      "type": "shell",
      "command": "node",
      "args": [
        "${workspaceFolder}/scripts/riscv-hello.mjs",
        "clean"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "problemMatcher": []
    }
  ]
}
