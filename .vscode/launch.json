{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QEMU hello_qemu (GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/riscv/hello_qemu/hello_qemu.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${workspaceFolder}/xpacks/.bin/riscv-none-elf-gdb",
      "windows": {
        "miDebuggerPath": "${workspaceFolder}/xpacks/@xpack-dev-tools/riscv-none-elf-gcc/.content/bin/riscv-none-elf-gdb.exe"
      },
      "miDebuggerServerAddress": "localhost:3333",
      "stopAtEntry": true,
      "externalConsole": false,
      "preLaunchTask": "riscv: debug hello_qemu",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Use the RV64 architecture",
          "text": "set architecture riscv:rv64",
          "ignoreFailures": false
        }
      ]
    },
    {
      "name": "QEMU hello_qemu (cortex-debug)",
      "type": "cortex-debug",
      "request": "attach",
      "servertype": "external",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/riscv/hello_qemu/hello_qemu.elf",
      "armToolchainPath": "${workspaceFolder}/xpacks/.bin",
      "toolchainPrefix": "riscv-none-elf",
      "gdbPath": "${workspaceFolder}/xpacks/.bin/riscv-none-elf-gdb",
      "windows": {
        "armToolchainPath": "${workspaceFolder}/xpacks/@xpack-dev-tools/riscv-none-elf-gcc/.content/bin",
        "gdbPath": "${workspaceFolder}/xpacks/@xpack-dev-tools/riscv-none-elf-gcc/.content/bin/riscv-none-elf-gdb.exe"
      },
      "gdbTarget": "localhost:3333",
      "preLaunchTask": "riscv: debug hello_qemu",
      "showDevDebugOutput": "raw"
    }
  ]
}
